{
  "manifest_version": 3,
  "name": "Mubaddil — مبدّل",
  "short_name": "Mubaddil",
  "version": "0.1.0",
  "description": "Catches typing in the wrong keyboard language, pauses so you notice, then remaps the keys and follows that language.",
  "action": {
    "default_title": "Mubaddil",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "engine/layouts.js",
        "engine/dictionaries.js",
        "engine/convert.js",
        "engine/detect.js",
        "engine/controller.js",
        "content.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
